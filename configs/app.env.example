# Example process configuration. The API does not load this file.
# Quote values when sourcing it, because the DSN contains "&".
#
#   set -a
#   source configs/app.env.example
#   set +a

HTTP_ADDR=":8080"
DB_DSN="file:app.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)"
# Run embedded SQL migrations automatically on API startup.
DB_AUTO_MIGRATE="true"
# Built frontend directory. Empty disables serving it.
WEBUI_DIR="webui/dist"
# Toggle middleware.RequireAuth enforcement (disabled by default until you wire a TokenVerifier).
AUTH_ENABLED="false"
